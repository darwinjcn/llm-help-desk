# ------------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores antes de arrancar.
# ------------------------------------------------------------------

# Base de datos (desde tu PC local; en docker compose el host es "postgres")
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk

# Seguridad — CAMBIA la clave en cualquier entorno real
JWT_SECRET=cambia-esta-clave-secreta
JWT_EXPIRE_MINUTES=720

# Ollama (local: http://localhost:11434 | docker compose: http://ollama:11434)
OLLAMA_BASE_URL=http://localhost:11434
TRIAGE_MODEL=qwen2.5:3b-instruct
RESOLUTION_MODEL=qwen2.5:3b-instruct
EMBEDDING_MODEL=nomic-embed-text

# Fragmentos de KB recuperados por consulta del agente de resolución
KB_TOP_K=4

# Usuario admin inicial (se crea solo si la BD está vacía)
# Debe tener dominio con punto: pydantic EmailStr rechaza "@local"
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin1234
